					"raw": "{\n  \"workflowCode\": \"CONTRACT_REQUEST\",\n  \"businessRecordId\": \"doc_acme_998877\",\n  \"variables\": {\n    \"contractValue\": 250000,\n    \"contractType\": \"VENDOR_AGREEMENT\",\n    \"department\": \"Engineering\",\n    \"vendor\": \"Acme Tech Solutions\"\n  },\n  \"tenantId\": \"tenant_acme_corp\"\n}"
